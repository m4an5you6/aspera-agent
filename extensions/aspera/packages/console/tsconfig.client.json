{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "lib",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "types": []
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/config.ts",
    "src/css-modules.d.ts"
  ]
}
