{
  "name": "aspera-extensions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "asperaEnvironmentTools": { "uvVersion": "0.13.0", "pipVersion": "26.2.1", "reuseVersion": 1, "cleanupVersion": 1, "installVersion": 3, "storageVersion": 1, "storageFormat": "0.1.0", "materialFormat": "0.1.2", "registrationFormat": "0.1.3", "reuseVerificationVersion": 1, "reusePrecheckVersion": 1, "wheelMetadataRepairVersion": 2, "managerCacheVersion": 1, "inputSharingVersion": 1, "releaseAssetSharingVersion": 1, "repairVersion": 1, "storagePreflightVersion": 2, "canonicalDatasetVersion": 1, "sandboxVersion": 1, "sandboxIpcVersion": 1, "commandOutputVersion": 1, "commandIdentityVersion": 1, "materialRecoveryVersion": 1, "lockReceiptVersion": 1, "requirementLedgerVersion": 1, "readonlyConsumerVersion": 2 },
  "asperaCompletionVersion": 1,
  "asperaPlanningTools": { "version": 1, "formatVersion": "0.1.0", "requirementsVersion": 1, "inferenceVersion": 1 },
  "asperaFinalizationVersion": 2,
  "asperaStageAttemptVersion": 1,
  "asperaStageEvidenceVersion": 4,
  "asperaCheckpointProtectionVersion": 1,
  "asperaAgentRecoveryVersion": 1,
  "asperaServiceVerificationVersion": 1,
  "asperaServiceLifecycleVersion": 1,
  "asperaInferenceCheckpointVersion": 1,
  "scripts": {
    "build": "pnpm run build:host && pnpm run gen:typert && pnpm run build:client",
    "build:host": "tsc -b tsconfig.host.json",
    "gen:typert": "node scripts/gen-typert.mjs",
    "build:client": "pnpm --filter @aspera/console run bundle",
    "typecheck": "tsc -b tsconfig.host.json && tsc -p packages/console/tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:web": "node scripts/test-web.mjs",
    "test:observations:web": "node scripts/test-observations-web.mjs",
    "update:desktop:resources": "node scripts/update-desktop-resources.mjs",
    "update:desktop:shell": "node scripts/update-desktop-shell.mjs",
    "test:installed": "node scripts/test-installed.mjs",
    "test:sandbox:linux": "pnpm run build:host && node --test packages/runtime/tests/sandbox-ipc-linux.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "test:storage:qwen": "node scripts/test-storage-qwen.mjs",
    "test:preparation": "node scripts/test-preparation.mjs",
    "test:completion": "node scripts/test-completion-review.mjs",
    "test:control": "node scripts/test-control.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:desktop:api": "node scripts/test-desktop-api.mjs",
    "test:desktop:deepseek": "node scripts/test-desktop-deepseek.mjs",
    "pack": "node scripts/pack.mjs",
    "lint": "oxlint -c .oxlintrc.json packages apps scripts",
    "dsh": "node scripts/dsh.mjs",
    "setup": "node scripts/setup.mjs",
    "start:web": "node scripts/start.mjs",
    "start:desktop": "pnpm --filter @aspera/desktop run start",
    "build:desktop": "pnpm run build && node scripts/package-desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@aspera/dispatch": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "tar": "7.5.22",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "tsdown": "0.22.2",
    "vitest": "^4.1.8",
    "tsx": "^4.22.4",
    "oxlint": "1.76.0",
    "@playwright/test": "^1.58.2",
    "lightningcss": "1.32.0",
    "@total-typescript/shoehorn": "0.1.2",
    "@aspera/runtime": "workspace:*",
    "@aspera/experiments": "workspace:*",
    "@aspera/console": "workspace:*",
    "@aspera/desktop": "workspace:*"
  }
}
